<?xml version="1.0"?>
<odoo>
    <record id="view_microsoft_calendar_event" model="ir.ui.view">
        <field name="name">microsoft_calendar.event.calendar</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <field name="location" position="after">
                <field name="microsoft_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_microsoft_calendar_event_form" model="ir.ui.view">
        <field name="name">microsoft_calendar.event.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_can_edit']" position="after">
                <field name="microsoft_id" invisible="1" /> <!-- Needed for invisible / readonly
                conditions -->
                <field name="microsoft_sync_active" invisible="1" />  <!-- Needed for invisible /
                readonly conditions -->
            </xpath>

            <xpath
                expr="//div[hasclass('oe_edit_only','alert-info')][@role='status']"
                position="attributes">
                <attribute name="invisible">not recurrence_id or (microsoft_id and recurrency)</attribute>
            </xpath>

            <xpath
                expr="//div[hasclass('oe_edit_only','alert-info')][@role='status']"
                position="after">
                <div invisible="not (microsoft_id and recurrency)" class="alert alert-info"
                    role="alert">
                    Recurring events synced from Outlook can only be edited from Outlook.
                </div>
            </xpath>

            <xpath expr="//field[@name='recurrency']" position="attributes">
                <attribute name="readonly">microsoft_sync_active or not user_can_edit</attribute>
            </xpath>

            <xpath expr="//div[field[@name='recurrency']]" position="after">
                <div invisible="recurrency or not microsoft_sync_active"
                    class="alert alert-info" role="alert"
                    colspan="2">
                    Recurring events must be created directly in Outlook Calendar.
                </div>
            </xpath>

            <xpath expr="//field[@name='interval']" position="attributes">
                <attribute name="readonly">microsoft_id and recurrency</attribute>
            </xpath>
            <xpath expr="//field[@name='rrule_type'][@nolabel='1']" position="attributes">
                <attribute name="readonly">microsoft_id and recurrency</attribute>
            </xpath>
        </field>
    </record>
</odoo>
