<odoo>

    <record id="res_partner_repair_button" model="ir.ui.view">
        <field name="name">res.partner.form.repair.button.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="3"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_repair_orders" icon="fa-wrench" groups="stock.group_stock_user">
                    <field string="Repair" name="repair_order_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
