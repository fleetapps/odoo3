<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="service_company_blueprint" model="populate.blueprint">
            <field name="name">Service Company - Project Module</field>
            <field name="definition_xml" type="xml">
                <!-- Create partners (customers) -->
                <model name="res.partner" count="500" id="service_customers">
                    <field name="name" generator="fake.company" null_frac="0"/>
                    <field name="email" generator="fake.company_email"/>
                    <field name="phone" generator="fake.phone_number"/>
                    <field name="is_company" eval="True"/>
                    <field name="active" eval="True"/>
                    <field name="street" generator="fake.street_address"/>
                    <field name="city" generator="fake.city"/>
                    <field name="zip" generator="fake.postcode"/>
                    <field
                        name="country_id"
                        generator="relation.one"
                        domain="[('code', 'in', ['US', 'CA', 'GB', 'DE', 'FR'])]"
                        null_frac="0.1"
                    />
                </model>

                <!-- Create internal users (employees) -->
                <model
                    name="res.users"
                    count="250"
                    id="project_users"
                    context="{'tracking_disable': True, 'install_mode': True}"
                >
                    <field name="name" generator="fake.name" null_frac="0"/>
                    <field name="login" generator="fake.user_name" unique="True"/>
                    <field name="email" generator="fake.email"/>
                </model>

                <!-- Create project stages -->
                <model name="project.project.stage" count="6" id="project_stages" scale="False">
                    <field
                        name="name"
                        generator="misc.cycle"
                        values="['New', 'In Progress', 'Review', 'Done', 'Archived', 'Cancelled']"
                    />
                    <field name="sequence" generator="scalar.integer" start="1" end="100"/>
                    <field name="fold" generator="scalar.boolean" values="{True: 1, False: 9}"/>
                </model>


                <!-- Create project task types (Kanban stages) -->
                <model name="project.task.type" count="8" id="task_types" scale="False">
                    <field
                        name="name"
                        generator="misc.cycle"
                        values="['To Do', 'In Progress', 'Testing', 'Blocked', 'Review', 'Done', 'On Hold', 'Cancelled']"
                    />
                    <field name="sequence" generator="misc.cycle" values="[1, 2, 3, 4, 5, 6, 7, 8]"/>
                </model>

                <!-- Create projects -->
                <model
                    name="project.project"
                    count="120"
                    id="service_projects"
                    context="{'mail_auto_subscribe_no_notify': True}"
                >  <!-- disable notifications to new assignees -->
                    <field name="name" generator="fake.catch_phrase"/>
                    <field name="active" generator="scalar.boolean" values="{True:9, False:1}"/>
                    <field name="partner_id" generator="relation.one" ref="service_customers" null_frac="0.2"/>
                    <field name="user_id" generator="relation.one" ref="project_users" null_frac="0.1"/>
                    <field
                        name="privacy_visibility"
                        generator="choice.selection"
                        values="{'portal':5, 'employees':3, 'followers':2}"
                        null_frac="0"
                    />
                    <field name="stage_id" generator="relation.one" ref="project_stages" null_frac="0.1"/>
                    <field
                        name="date_start"
                        generator="temporal.date"
                        start="today -6m"
                        end="today -1y"
                        distribution="normal(mean=270, std=60)"
                    />
                    <field
                        name="date"
                        generator="temporal.date"
                        start="today"
                        end="today -6m +1d"
                        distribution="normal(mean=60, std=40)"
                    />
                    <field
                        name="allow_task_dependencies"
                        generator="scalar.boolean"
                        values="{True:4, False:6}"
                    />
                    <field name="allow_milestones" generator="scalar.boolean" values="[True, False]"/>
                    <field
                        name="allow_recurring_tasks"
                        generator="scalar.boolean"
                        values="{True:2, False:8}"
                    />
                    <field name="sequence" generator="scalar.integer" start="1" end="100"/>
                    <field name="color" generator="scalar.integer" start="0" end="11"/>
                    <field
                        name="last_update_status"
                        generator="choice.selection"
                        values="{'on_track':4, 'at_risk':2, 'off_track':1, 'on_hold':1, 'to_define':2}"
                        null_frac="0"
                    />
                    <field name="type_ids" generator="relation.many" ref="task_types" count="8" null_frac="0"/>
                </model>

                <!-- Create project tags -->
                <model name="project.tags" count="200" id="project_tags">
                    <field name="v_name" virtual="True" generator="fake.word" null_frac="0"/>
                    <field name="v_rng_suffix" virtual="True" generator="textual.char" length="4" null_frac="0"/>
                    <field
                        name="name"
                        eval="v_name + '_' + v_rng_suffix"
                        unique="True"
                        null_frac="0"
                    />
                    <field name="color" generator="scalar.integer" start="0" end="11"/>
                </model>

                <!-- Create milestones (for projects with allow_milestones=True) -->
                <model name="project.milestone" count="180" id="project_milestones">
                    <field name="name" generator="fake.bs"/>
                    <field
                        name="project_id"
                        generator="relation.one"
                        ref="service_projects"
                        domain="[('allow_milestones', '=', True)]"
                    />
                    <field
                        name="deadline"
                        generator="temporal.date"
                        start="today"
                        end="today -120d"
                        distribution="triangular(min=0, max=120, mode=30)"
                    />
                    <field name="is_reached" generator="scalar.boolean" values="{True:3, False:7}"/>
                </model>

                <!-- Create main tasks (no parent) -->
                <model
                    name="project.task"
                    count="1600"
                    id="main_tasks"
                    context="{'mail_auto_subscribe_no_notify': True}"
                >
                    <field name="name" generator="fake.sentence" nb_words="5"/>
                    <field name="project_id" generator="relation.one" ref="service_projects" null_frac="0"/>
                    <field name="stage_id" generator="relation.one" ref="task_types"/>
                    <field
                        name="user_ids"
                        generator="relation.many"
                        ref="project_users"
                        count="2"
                        null_frac="0.2"
                    />
                    <field name="partner_id" generator="relation.one" ref="service_customers" null_frac="0.4"/>
                    <field name="description" generator="fake.paragraph" null_frac="0.3"/>
                    <field
                        name="priority"
                        generator="choice.selection"
                        values="{'0':7, '1':3}"
                        null_frac="0"
                    />
                    <field
                        name="state"
                        generator="choice.selection"
                        values="{'01_in_progress':5, '02_changes_requested':1, '03_approved':2, '04_waiting_normal':1, '1_done':3, '1_canceled':1}"
                        null_frac="0"
                    />
                    <field
                        name="date_deadline"
                        generator="temporal.datetime"
                        start="now -20d"
                        end="now +90d"
                        distribution="exponential(rate=0.03)"
                        null_frac="0.3"
                    />
                    <field name="date_assign" generator="temporal.datetime" start="now" end="now -6m" null_frac="0.2"/>
                    <field
                        name="allocated_hours"
                        generator="scalar.float"
                        start="1.0"
                        end="80.0"
                        distribution="normal(mean=20, std=15)"
                        null_frac="0.2"
                    />
                    <field name="sequence" generator="scalar.integer" start="1" end="100"/>
                    <field name="color" generator="scalar.integer" start="0" end="11" null_frac="0.7"/>
                    <field name="active" generator="scalar.boolean" values="{True:95, False:5}"/>
                </model>

                <!-- Link tags to main tasks -->
                <model name="project.task" type="write" ref="main_tasks">
                    <field
                        name="tag_ids"
                        generator="relation.many"
                        ref="project_tags"
                        count="3"
                        null_frac="0.4"
                    />
                </model>

                <!-- Link milestones to tasks -->
                <model name="project.task" type="write" ref="main_tasks">
                    <field name="milestone_id" generator="relation.one" ref="project_milestones" null_frac="0.7"/>
                </model>

                <!-- Create subtasks (with parent_id) -->
                <model name="project.task" count="2000" id="subtasks" context="{'mail_auto_subscribe_no_notify': True}">
                    <field name="name" generator="fake.sentence" nb_words="4"/>
                    <field name="parent_id" generator="relation.one" ref="main_tasks" null_frac="0"/>
                    <field name="project_id" generator="relation.one" ref="service_projects" null_frac="0"/>
                    <field
                        name="user_ids"
                        generator="relation.many"
                        ref="project_users"
                        count="1"
                        null_frac="0.3"
                    />
                    <field name="description" generator="fake.text" max_nb_chars="150" null_frac="0.5"/>
                    <field
                        name="priority"
                        generator="choice.selection"
                        values="{'0':8, '1':2}"
                        null_frac="0"
                    />
                    <field
                        name="state"
                        generator="choice.selection"
                        values="{'01_in_progress':4, '03_approved':2, '1_done':3, '1_canceled':1}"
                        null_frac="0"
                    />
                    <field name="date_deadline" generator="temporal.datetime" start="now -10d" end="now +2m" null_frac="0.4"/>
                    <field
                        name="allocated_hours"
                        generator="scalar.float"
                        start="0.5"
                        end="20.0"
                        distribution="exponential(rate=0.1)"
                        null_frac="0.3"
                    />
                    <field name="sequence" generator="scalar.integer" start="1" end="50"/>
                    <field name="active" eval="True"/>
                </model>

                <!-- Create project favorites (users marking projects as favorite) -->
                <model name="project.project" type="write" ref="service_projects">
                    <field
                        name="favorite_user_ids"
                        generator="relation.many"
                        ref="project_users"
                        count="50"
                        null_frac="0.7"
                    />
                </model>

                <!-- Create project updates (status updates) -->
                <model name="project.update" count="320" id="project_updates" parallel="False">
                    <field name="name" generator="fake.sentence" nb_words="6"/>
                    <field name="project_id" generator="relation.one" ref="service_projects" null_frac="0"/>
                    <field
                        name="status"
                        generator="choice.selection"
                        values="{'on_track':5, 'at_risk':2, 'off_track':1, 'on_hold':2}"
                        null_frac="0"
                    />
                    <field name="description" generator="fake.paragraph" null_frac="0.2"/>
                    <field
                        name="progress"
                        generator="scalar.integer"
                        start="0"
                        end="100"
                        distribution="beta(alpha=2, beta=2)"
                    />
                </model>

                <!-- Create recurring tasks (for projects with allow_recurring_tasks=True) -->
                <model
                    name="project.task"
                    count="300"
                    id="recurring_tasks"
                    context="{'mail_auto_subscribe_no_notify': True}"
                >
                    <field name="name" generator="fake.sentence" nb_words="4"/>
                    <field
                        name="project_id"
                        generator="relation.one"
                        ref="service_projects"
                        domain="[('allow_recurring_tasks', '=', True)]"
                        null_frac="0"
                    />
                    <field name="recurring_task" eval="True"/>
                    <field
                        name="user_ids"
                        generator="relation.many"
                        ref="project_users"
                        count="1"
                        null_frac="0.1"
                    />
                    <field name="description" generator="fake.text" max_nb_chars="120" null_frac="0.4"/>
                    <field name="priority" eval="'0'"/>
                    <field name="state" eval="'01_in_progress'"/>
                    <field
                        name="allocated_hours"
                        generator="scalar.float"
                        start="2.0"
                        end="16.0"
                        distribution="normal(mean=8, std=4)"
                    />
                    <field name="active" eval="True"/>
                </model>

                <!-- Create project collaborators (for shared projects) -->
                <model name="project.collaborator" count="100" id="project_collaborators">
                    <field
                        name="project_id"
                        generator="relation.one"
                        ref="service_projects"
                        domain="[('privacy_visibility', 'in', ['portal', 'invited_users'])]"
                        null_frac="0"
                    />
                    <field
                        name="partner_id"
                        generator="relation.one"
                        ref="service_customers"
                        unique="True"
                        null_frac="0"
                    />
                </model>
            </field>
        </record>
    </data>
</odoo>