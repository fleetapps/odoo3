<?xml version="1.0"?>
<odoo>
    <record id="view_crm_lead2opportunity_partner_mass" model="ir.ui.view">
        <field name="name">crm.lead2opportunity.partner.mass.form</field>
        <field name="model">crm.lead2opportunity.partner.mass</field>
        <field name="arch" type="xml">
            <form string="Convert to Opportunities">
                <div class="alert alert-info" role="alert" invisible="not duplicated_lead_ids">
                    <field name="lead_count_message"/>
                </div>
                <field name="lead_tomerge_ids" invisible="1"/>
                <group invisible="not duplicated_lead_ids">
                    <field name="name" class="oe_inline" widget="selection_badge" nolabel="1" invisible="duplicated_opportunity_ids" options="{'excludedOptions': ['convert_and_merge']}"/>
                    <field name="name" class="oe_inline" widget="selection_badge" nolabel="1" invisible="not duplicated_opportunity_ids"/>
                </group>
                <group invisible="name == 'deduplicate'">
                    <group string="Assign these opportunities to">
                        <field name="user_ids" widget="many2many_avatar_user" domain="[('share', '=', False)]" placeholder="Keep current users"/>
                        <field name="team_id" context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}" placeholder="Keep current teams"/>
                        <field name="force_assignment" invisible="not team_id and not user_ids"/>
                    </group>
                    <group string="Customers" col="4">
                        <label for="link_to_existing_customer" colspan="3"/>
                        <field name="link_to_existing_customer" colspan="1" widget="boolean_toggle" nolabel="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Duplicate leads" invisible="name != 'deduplicate'">
                        <group>
                            <field name="duplicated_lead_ids" nolabel="1">
                                <list create="false">
                                    <field name="create_date"/>
                                    <field name="name" string="Title"/>
                                    <field name="type" optional="show"/>
                                    <field name="contact_name" optional="show"/>
                                    <field name="country_id" column_invisible="context.get('invisible_country', True)" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="email_from" optional="show"/>
                                    <field name="stage_id"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="team_id" optional="hide"/>
                                    <control>
                                        <create string="Add a line" invisible="1"/>
                                    </control>
                                </list>
                            </field>
                        </group>
                    </page>
                    <page string="Duplicate opportunities" invisible="name != 'convert_and_merge'">
                        <group>
                            <field name="duplicated_opportunity_ids" nolabel="1">
                                <list create="false">
                                    <field name="create_date"/>
                                    <field name="name" string="Title"/>
                                    <field name="type" optional="show"/>
                                    <field name="contact_name" optional="show"/>
                                    <field name="country_id" column_invisible="context.get('invisible_country', True)" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="email_from" optional="show"/>
                                    <field name="stage_id"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="team_id" optional="hide"/>
                                    <control>
                                        <create string="Add a line" invisible="1"/>
                                    </control>
                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button string="Convert" name="action_apply" invisible="name == 'deduplicate'" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Deduplicate" name="action_apply" invisible="name != 'deduplicate'" type="object" class="btn-primary" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_send_mass_convert" model="ir.actions.act_window">
        <field name="name">Convert to opportunities</field>
        <field name="res_model">crm.lead2opportunity.partner.mass</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_lead2opportunity_partner_mass"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size' : 'large'}</field>
        <field name="binding_model_id" ref="model_crm_lead"/>
        <field name="binding_view_types">list,kanban</field>
    </record>

    <record id="action_crm_lead2opportunity_mass_convert" model="ir.actions.act_window">
        <field name="name">Convert to opportunities</field>
        <field name="res_model">crm.lead2opportunity.partner.mass</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_lead2opportunity_partner_mass"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size' : 'large'}</field>
    </record>
</odoo>
