<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="discuss.CallSettings">
        <ActionPanel t-if="props.withActionPanel" title.translate="Voice &amp; Video Settings" icon="'fa fa-gear'">
            <t t-call="discuss.CallSettings.content" />
        </ActionPanel>
        <t t-else="" t-call="discuss.CallSettings.content" />
    </t>

    <t t-name="discuss.CallSettings.content">
        <div class="o-discuss-CallSettings d-flex flex-column">
            <Tabs direction="'h'" initialTabId="'voice'">
                <t t-set-slot="headers">
                    <TabHeader id="'voice'" title.translate="Voice &amp; Audio">
                        <div class="py-1 px-2"><i class="fa fa-microphone me-2"/>Voice &amp; Audio</div>
                    </TabHeader>
                    <TabHeader id="'video'" title.translate="Video">
                        <div class="py-1 px-2"><i class="fa fa-video-camera me-2"/>Video</div>
                    </TabHeader>
                    <TabHeader t-if="env.debug" id="'technical'" title.translate="Technical">
                        <div class="py-1 px-2"><i class="fa fa-cogs me-2"/>Technical</div>
                    </TabHeader>
                </t>
                <t t-set-slot="panels">
                    <TabPanel id="'voice'">
                        <div class="d-flex flex-column my-2 p-1">
                            <div class="d-flex gap-2" t-att-class="props.isCompact or isMobileOS ? 'flex-column' : 'flex-row'">
                                <div class="d-flex flex-column flex-grow-1 gap-1 overflow-hidden" t-att-class="props.isCompact or isMobileOS ? 'w-100' : 'w-50'" aria-label="Microphone">
                                    <span class="flex-shrink-0 fw-bold text-muted small text-uppercase">
                                        <i class="fa fa-microphone text-muted ms-1 me-2"/>Microphone
                                    </span>
                                    <DeviceSelect kind="'audioinput'"/>
                                </div>
                                <div class="d-flex flex-column flex-grow-1 gap-1 overflow-hidden" t-att-class="props.isCompact or isMobileOS ? 'w-100' : 'w-50'" aria-label="Speakers">
                                    <span class="flex-shrink-0 fw-bold text-muted small text-uppercase">
                                        <i class="fa fa-volume-up text-muted ms-1 me-2"/>Speakers
                                    </span>
                                    <DeviceSelect kind="'audiooutput'"/>
                                </div>
                            </div>
                            <hr class="my-3 border-secondary opacity-75"/>
                            <div class="d-flex flex-column gap-2">
                                <span class="flex-shrink-0 fw-bold text-muted small text-uppercase">
                                    <i class="fa fa-rss text-muted ms-1 me-2"/>Activation Mode
                                </span>
                                <span t-if="store.settings.use_push_to_talk and !isMobileOS and !pttExtService.isEnabled" class="small text-muted fst-italic alert alert-warning px-3 py-2 m-0" t-out="pttExtService.downloadText"/>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn flex-grow-1" t-att-class="!store.settings.use_push_to_talk ? 'btn-primary' : 'btn-secondary text-muted'" t-on-click="()=>this.store.settings.setPushToTalk(false)">
                                        <i class="fa fa-microphone me-2"/>
                                        <span>Voice Detection</span>
                                    </button>
                                    <button type="button" class="btn flex-grow-1" t-att-class="store.settings.use_push_to_talk ? 'btn-primary' : 'btn-secondary text-muted'" t-on-click="()=>this.store.settings.setPushToTalk(true)">
                                        <i class="fa fa-keyboard-o me-2"/>
                                        <span>Push-to-talk</span>
                                    </button>
                                </div>
                                <t t-if="!store.settings.use_push_to_talk">
                                    <div class="d-flex flex-column gap-2">
                                        <span class="text-muted ps-1 pt-2"><i class="fa fa-info-circle me-2"/>Adjust so the indicator moves past the slider handle when you speak.</span>
                                        <div class="d-flex gap-2" t-att-class="props.isCompact or isMobileOS ? 'flex-column' : 'flex-row'">
                                            <button class="btn px-3 flex-shrink-0" t-att-class="microphoneVolume.isActive ? 'btn-danger' : 'btn-secondary'" t-on-click="microphoneVolume.toggle" t-att-disabled="!microphoneVolume.isReady">
                                                <i class="fa me-2" t-att-class="microphoneVolume.isActive ? 'fa-stop' : 'fa-microphone'"/>
                                                <t t-out="microphoneVolume.isActive ? stopText : testText"/>
                                            </button>
                                            <input class="o-Discuss-CallSettings-thresholdInput form-range rounded border py-3 px-2" t-attf-style="--volume: {{microphoneVolume.value * 100}}%;" type="range" min="0.001" max="1" step="0.001" t-model="store.settings.voiceActivationThreshold" title="Voice detection sensitivity"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="store.settings.use_push_to_talk">
                                    <div class="d-flex flex-column gap-2">
                                        <span class="text-muted ps-1 pt-2">
                                            <i class="fa fa-info-circle me-2"/>
                                            <t t-if="store.settings.isRegisteringKey">Press any key to register it as your shortcut.</t>
                                            <t t-else="">Click the button below to register a new shortcut.</t>
                                        </span>
                                        <div class="d-flex gap-2" t-att-class="props.isCompact or isMobileOS ? 'flex-column' : 'flex-row'">
                                            <button class="btn px-4 flex-shrink-0" t-att-class="store.settings.isRegisteringKey ? 'btn-danger' : 'btn-secondary'" t-on-click="onClickRegisterKeyButton" aria-label="Register new shortcut">
                                                <i class="fa me-2" t-att-class="store.settings.isRegisteringKey ? 'fa-times' : 'fa-keyboard-o'"/>
                                                <t t-out="store.settings.pushToTalkKeyText"/>
                                            </button>
                                            <div class="d-flex align-items-center flex-grow-1 gap-2 border rounded px-2 py-1">
                                                <small class="text-muted text-nowrap">Delay:</small>
                                                <input class="flex-grow-1 form-range" type="range" min="0" max="2000" step="1" t-att-value="store.settings.voice_active_duration" t-on-input="onChangeDelay" title="Delay after releasing push-to-talk"/>
                                                <small class="fw-bold">
                                                    <t t-out="store.settings.voice_active_duration"/>ms
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </TabPanel>
                    <TabPanel id="'video'">
                        <div class="d-flex flex-column my-2 p-1">
                            <div class="d-flex flex-column flex-grow-1 gap-1" aria-label="Camera">
                                <span class="flex-shrink-0 fw-bold text-muted small text-uppercase">
                                    <i class="fa fa-video-camera text-muted ms-1 me-2"/>Camera
                                </span>
                                <DeviceSelect kind="'videoinput'"/>
                            </div>
                            <hr class="my-3 border-secondary opacity-75"/>
                            <div class="d-flex flex-column border rounded">
                                <t t-call="discuss.CallSettings.textToggler">
                                    <t t-set="text">Show video participants only</t>
                                    <t t-set="description">Hide participants who have turned off their camera.</t>
                                    <t t-set="value" t-value="store.settings.showOnlyVideo"/>
                                    <t t-set="onchange" t-value="onChangeShowOnlyVideo"/>
                                </t>
                                <hr class="border-secondary opacity-75 m-0"/>
                                <t t-call="discuss.CallSettings.textToggler">
                                    <t t-set="text">Auto-focus speaker</t>
                                    <t t-set="description">Automatically enlarge the person currently speaking.</t>
                                    <t t-set="value" t-value="store.settings.useCallAutoFocus"/>
                                    <t t-set="onchange" t-value="onChangeCallAutoFocus"/>
                                </t>
                                <hr class="border-secondary opacity-75 m-0"/>
                                <t t-if="store.settings.hasCanvasFilterSupport">
                                    <t t-call="discuss.CallSettings.textToggler">
                                        <t t-set="text">Blur video background</t>
                                        <t t-set="description">Apply a privacy blur to your surroundings.</t>
                                        <t t-set="value" t-value="store.settings.useBlur"/>
                                        <t t-set="onchange" t-value="onChangeBlur"/>
                                    </t>
                                </t>
                                <t t-if="store.settings.useBlur">
                                    <div class="d-flex gap-3 o-py-2_5 px-3" t-att-class="props.isCompact or isMobileOS ? 'flex-column' : 'flex-row'">
                                        <div class="d-flex flex-column flex-grow-1 gap-1" title="Background blur intensity" aria-label="Background blur intensity">
                                            <span class="flex-shrink-0 d-flex justify-content-between fw-bold text-muted small text-uppercase">
                                                <span>Intensity</span>
                                                <span class="o-discuss-DiscussCallSettings-width-text-percentage"><t t-out="Math.floor(store.settings.backgroundBlurAmount * 5)"/>%</span>
                                            </span>
                                            <input class="form-range" type="range" min="0" max="20" step="1" t-att-value="store.settings.backgroundBlurAmount" t-on-change="onChangeBackgroundBlurAmount"/>
                                        </div>
                                        <div class="d-flex flex-column flex-grow-1 gap-1" title="Edge blur intensity" aria-label="Edge blur intensity">
                                            <span class="flex-shrink-0 d-flex justify-content-between fw-bold text-muted small text-uppercase">
                                                <span>Edge Softness</span>
                                                <span class="o-discuss-DiscussCallSettings-width-text-percentage"><t t-out="Math.floor(store.settings.edgeBlurAmount * 5)"/>%</span>
                                            </span>
                                            <input class="form-range" type="range" min="0" max="20" step="1" t-att-value="store.settings.edgeBlurAmount" t-on-change="onChangeEdgeBlurAmount"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </TabPanel>
                    <TabPanel id="'technical'">
                        <div class="d-flex flex-column my-2 p-1">
                            <div class="d-flex flex-column border rounded">
                                <t t-call="discuss.CallSettings.textToggler">
                                    <t t-set="text">Log RTC events</t>
                                    <t t-set="description">Save detailed RTC connection logs for troubleshooting.</t>
                                    <t t-set="value" t-value="store.settings.logRtc"/>
                                    <t t-set="onchange" t-value="onChangeLogRtc"/>
                                </t>
                                <button class="btn btn-secondary rounded-top-0" t-on-click="onClickDownloadLogs"><i class="fa fa-download me-2"/><span>Download Logs</span></button>
                            </div>
                        </div>
                    </TabPanel>
                </t>
            </Tabs>
        </div>
    </t>
    <t t-name="discuss.CallSettings.textToggler">
        <label class="o-discuss-CallSettings-item d-flex align-items-center justify-content-between o-py-2_5 px-3 cursor-pointer">
            <div class="d-flex flex-column user-select-none">
                <span class="fw-bold" t-out="text"/>
                <small class="text-muted fst-italic" t-out="description"/>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" t-on-change="onchange" t-att-checked="value" t-att-title="text" t-att-aria-label="text"/>
            </div>
        </label>
    </t>
</templates>
