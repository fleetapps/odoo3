<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sample_supplier_blueprint" model="populate.blueprint">
            <field name="name">Sample Supplier Data</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.supplier" count="10">
                    <field name="name" generator="textual.char" length="20"/>
                    <field name="email" generator="textual.char" length="25"/>
                    <field name="phone" generator="textual.char" length="12"/>
                    <field name="country_code" generator="choice.selection"/>
                    <field name="rating" generator="scalar.float" start="1.0" end="5.0"/>
                    <field name="is_active" generator="scalar.boolean"/>
                    <field name="established_date" generator="temporal.date" start="today -1y" end="today -20y"/>
                    <field name="notes" generator="textual.text" length="100"/>
                </model>
            </field>
        </record>

        <record id="sample_product_blueprint" model="populate.blueprint">
            <field name="name">Sample Product Data</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.product" count="50">
                    <field name="name" generator="textual.char" length="15"/>
                    <field name="price" generator="scalar.float" start="5.0" end="999.99"/>
                    <field name="cost" generator="scalar.float" start="1.0" end="500.0"/>
                    <field name="active" generator="scalar.boolean"/>
                    <field name="description" generator="textual.text" length="200"/>
                    <field name="category" generator="choice.selection"/>
                    <field name="created_date" generator="temporal.date" start="today" end="today +1y"/>
                    <field name="updated_at" generator="temporal.datetime" start="now" end="now -6m"/>
                    <field name="stock_quantity" generator="scalar.integer" start="0" end="1000"/>
                    <field name="is_featured" generator="scalar.boolean"/>
                </model>
            </field>
        </record>

        <record id="sample_static_blueprint" model="populate.blueprint">
            <field name="name">Sample Static Data</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.customer" count="5">
                    <field name="name" eval="&quot;VIP Customer&quot;"/>
                    <field name="email" generator="textual.char" length="30"/>
                    <field name="age" eval="35"/>
                    <field name="is_vip" eval="True"/>
                    <field name="preferred_category" eval="&quot;electronics&quot;"/>
                    <field name="total_spent" eval="1000.0"/>
                    <field name="registration_date" generator="temporal.datetime"/>
                    <field name="notes" eval="&quot;Premium customer with special privileges&quot;"/>
                </model>
            </field>
        </record>

        <record id="sample_complex_blueprint" model="populate.blueprint">
            <field name="name">Complex Multi-Model Data</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.supplier" count="5">
                    <field name="name" generator="textual.char" length="25"/>
                    <field name="email" generator="textual.char" length="30"/>
                    <field name="country_code" generator="choice.selection" values="['US', 'CA', 'GB']"/>
                    <field name="rating" generator="scalar.float" start="3.0" end="5.0"/>
                    <field name="is_active" eval="True"/>
                </model>
                <model name="test_populate.product" count="20">
                    <field name="name" generator="textual.char" length="20"/>
                    <field name="price" generator="scalar.float" start="10.0" end="500.0"/>
                    <field name="category" generator="choice.selection" values="{'electronics': 3, 'books': 1}"/>
                    <field name="active" eval="True"/>
                    <field name="stock_quantity" generator="scalar.integer" start="10" end="100"/>
                    <field
                        name="supplier_id"
                        generator="relation.one"
                        domain="[('country_code', '=', 'US')]"
                        null_frac="0.1"
                    />
                </model>
                <model name="test_populate.customer" count="15">
                    <field name="name" generator="textual.char" length="18"/>
                    <field name="email" generator="textual.char" length="25"/>
                    <field name="age" generator="scalar.integer" start="18" end="65"/>
                    <field name="preferred_category" generator="choice.selection"/>
                    <field name="total_spent" generator="scalar.float" start="0.0" end="5000.0"/>
                </model>
            </field>
        </record>

        <record id="sample_writing_blueprint" model="populate.blueprint">
            <field name="name">Writing blueprint</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.supplier" count="5" id="some_supplies">
                    <field name="name" generator="textual.char" length="25"/>
                    <field name="is_active" eval="True"/>
                </model>
                <model name="test_populate.supplier" type="write" ref="some_supplies">
                    <field name="is_active" eval="False"/>
                </model>
            </field>
        </record>

        <record id="sample_subjobs_many_records_blueprint" model="populate.blueprint">
            <field name="name">Subjobs Blueprint</field>
            <field name="definition_xml" type="xml">
                <model name="test_populate.product" count="100000">
                    <field name="name" generator="textual.char" length="10"/>
                    <field name="price" generator="scalar.float" start="1.0" end="100.0"/>
                    <field name="active" eval="True"/>
                    <field name="stock_quantity" generator="scalar.integer" start="1" end="1000"/>
                </model>
            </field>
        </record>
    </data>
</odoo>
